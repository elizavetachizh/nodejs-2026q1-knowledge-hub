PORT=4000

CRYPT_SALT=10
JWT_SECRET=secret123123
JWT_REFRESH_SECRET=secret123123
JWT_SECRET_REFRESH_KEY=secret123123

POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LOGIN_TTL=60000
THROTTLE_AUTH_LOGIN_LIMIT=100
THROTTLE_AUTH_SIGNUP_TTL=60000
THROTTLE_AUTH_SIGNUP_LIMIT=100

# local app + docker db
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb?schema=public"

# docker app + docker db
# DATABASE_URL="postgresql://myuser:mypassword@db:5432/mydb?schema=public"
