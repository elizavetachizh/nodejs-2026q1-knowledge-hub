PORT=4000

CRYPT_SALT=10
JWT_SECRET=secret123123
JWT_REFRESH_SECRET=secret123123
JWT_SECRET_REFRESH_KEY=secret123123

POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

THROTTLE_TTL=60000
THROTTLE_LIMIT=120
THROTTLE_AUTH_LOGIN_TTL=60000
THROTTLE_AUTH_LOGIN_LIMIT=100
THROTTLE_AUTH_SIGNUP_TTL=60000
THROTTLE_AUTH_SIGNUP_LIMIT=100

# local app + docker db
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb?schema=public"

# docker app + docker db
# DATABASE_URL="postgresql://myuser:mypassword@db:5432/mydb?schema=public"

LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300
AI_RATE_WINDOW_MS=60000

GEMINI_EMBEDDING_MODEL=text-embedding-004
RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://vectordb:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
RAG_VECTOR_SIZE=768
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CONVERSATION_MAX_MESSAGES=20