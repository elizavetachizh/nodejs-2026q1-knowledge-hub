JWT_SECRET
JWT_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# local app + docker db
DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb?schema=public"

